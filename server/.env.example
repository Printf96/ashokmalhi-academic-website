# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local example: mongodb://127.0.0.1:27017/ashokmalhi-academic
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ashokmalhi-academic
MONGODB_URI=mongodb://127.0.0.1:27017/ashokmalhi-academic

# CORS - comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# Public site URL (used for canonical URLs, sitemap, JSON-LD, OG tags)
SITE_URL=https://ashokmalhi.pro

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Admin authentication (future content-management use)
# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Contact form email delivery (optional; leave blank to only store submissions)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFICATION_EMAIL=
